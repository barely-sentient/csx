{
  "comments": { "lineComment": "//", "blockComment": ["/*", "*/"] },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"], ["<", ">"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"], ["<", ">"]],
  "onEnterRules": [
    {
      "beforeText": "<([A-Za-z][\\w.:-]*)(?:<[^>]*>)?(?:\\s[^>]*)?>\\s*$",
      "afterText": "^\\s*</[A-Za-z][\\w.:-]*>",
      "action": { "indent": "indentOutdent" }
    }
  ]
}