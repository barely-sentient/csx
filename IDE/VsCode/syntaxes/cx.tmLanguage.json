{
  "name": "CSX",
  "scopeName": "source.cx",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#jsx" },
    { "include": "#numbers" },
    { "include": "#types" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.cx", "match": "//.*$" },
        { "name": "comment.block.cx", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.double.cx", "begin": "\"", "end": "\"", "patterns": [{ "match": "\\\\." }] },
        { "name": "string.quoted.single.cx", "begin": "'", "end": "'", "patterns": [{ "match": "\\\\." }] },
        { "name": "string.interpolated.cx", "begin": "\\$\"", "end": "\"", "patterns": [{ "match": "\\\\." }] }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cx",
          "match": "\\b(if|else|for|foreach|while|do|switch|case|break|continue|return|try|catch|finally|throw|using|namespace|class|struct|interface|enum|record|public|private|protected|internal|static|readonly|const|var|new|this|base|async|await|true|false|null|void|get|set|init|value|where|typeof|nameof|default|checked|unchecked|lock|in|out|ref|params|is|as)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.cx", "match": "=>" },
        { "name": "keyword.operator.lambda.cx", "match": "->" },
        { "name": "keyword.operator.null-conditional.cx", "match": "\\?\\.|\\?\\?" },
        { "name": "keyword.operator.comparison.cx", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.cx", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.assignment.cx", "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|=" },
        { "name": "keyword.operator.arithmetic.cx", "match": "\\+\\+|--|\\+|-|\\*|/|%|<<|>>" },
        { "name": "keyword.operator.bitwise.cx", "match": "&|\\||\\^|~" },
        { "name": "keyword.operator.other.cx", "match": "::|\\?|:" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.cx", "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?[fFdDmMlLuU]*\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.generic.cx", "match": "<[A-Za-z_][A-Za-z0-9_., <]*>" },
        { "name": "support.type.cx", "match": "\\b(int|bool|byte|sbyte|short|ushort|int|uint|long|ulong|float|double|decimal|char|string|object|void|dynamic|nint|nuint)\\b" }
      ]
    },
    "jsx": {
      "patterns": [
        {
          "name": "meta.tag.cx",
          "begin": "(</?)([A-Za-z][A-Za-z0-9_.]*)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.cx" },
            "2": { "name": "entity.name.tag.cx" }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.cx" }
          },
          "patterns": [
            { "include": "#jsx-attribute" },
            { "include": "#strings" },
            { "include": "#jsx-expression" }
          ]
        },
        { "include": "#jsx-expression" }
      ]
    },
    "jsx-attribute": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.cx",
          "match": "[A-Za-z_:][A-Za-z0-9_.:-]*"
        }
      ]
    },
    "jsx-expression": {
      "patterns": [
        {
          "name": "meta.embedded.expression.cx",
          "begin": "\\{",
          "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.cx" } },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.section.embedded.end.cx" } },
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    }
  }
}